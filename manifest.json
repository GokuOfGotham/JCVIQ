{
  "manifest_version": 3,
  "name": "JCVIQ - YouTube AI Optimizer",
  "version": "2.5",
  "description": "Free local-AI YouTube optimizer powered by NeuroBrain OS (CORTEX-5): local LLM titles, hooks, descriptions, tags and chapters, plus local Z-Image Turbo thumbnails, grounded in 0-5s neuroscience. No paid API.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://*.youtube.com/*",
    "https://i.ytimg.com/*",
    "http://192.168.1.76:8765/*",
    "http://gamingpc-rx:8765/*",
    "http://gamingpc-rx.tailef6e18.ts.net:8765/*",
    "http://100.73.1.112:8765/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JCVIQ - show or hide the panel on YouTube or Studio",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/icon48.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ]
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
